{
  "name": "@octovault/ui",
  "version": "0.0.0",
  "private": true,
  "description": "OctoVault — native UI primitives (@expo/ui wrappers) for the Ink & Pearl app.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.4",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*"
  },
  "peerDependenciesMeta": {
    "@expo/ui": { "optional": true },
    "react-native-reanimated": { "optional": true }
  },
  "devDependencies": {
    "@octovault/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
